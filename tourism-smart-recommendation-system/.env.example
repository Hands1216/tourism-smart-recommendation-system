# =============================================
# 部署密钥与敏感配置（模板文件）
# =============================================
# 使用方式：本文件复制为 .env 后填入真实值，由 docker-compose 自动读取
#   cp .env.example .env
# .env 已加入 .gitignore，不会被提交

# ---------- 数据库 ----------
DB_USERNAME=root
DB_PASSWORD=your-db-password

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- JWT ----------
# 建议用 openssl rand -base64 48 生成随机串
JWT_SECRET=your-jwt-secret-please-generate-a-random-string
JWT_EXPIRATION=604800000

# ---------- 大语言模型（DeepSeek） ----------
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ---------- 阿里云短信 ----------
ALIYUN_SMS_ENABLED=false
ALIYUN_SMS_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_SMS_SIGN_NAME=your-sms-sign-name
ALIYUN_SMS_TEMPLATE_CODE=your-sms-template-code

# ---------- 微信开放平台 ----------
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# ---------- 高德地图 ----------
AMAP_ENABLED=true
AMAP_KEY=your-amap-key

# ---------- 和风天气（JWT 认证，Ed25519） ----------
WEATHER_ENABLED=true
WEATHER_AUTH_TYPE=jwt
WEATHER_KEY=your-weather-key
WEATHER_PROJECT_ID=your-weather-project-id
WEATHER_KEY_ID=your-weather-key-id
# 注：Ed25519 私钥（PEM 多行）保留在 application.yml 的 external.weather.private-key 字段
# 不通过环境变量传，因为 .env 难以承载多行字符串
